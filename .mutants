# the changes the mutation run lets by, each with why it makes no
# difference: NAME :: WHY, the name as the report prints it
#
# the four lines for internal/mocks are the exception. they are not
# equivalent changes: they are in generated code that game mutants cannot
# be told to leave out, and their reason begins "excluded: generated by
# mockgen".

palette/tables.go At: !(value >= 0 && value <= 1) => !(value > 0 && value <= 1) :: at 0 the table holds the curve's own value at 0, so asking the curve gives the same answer
palette/tables.go At: !(value >= 0 && value <= 1) => !(value >= 0 && value < 1) :: at 1 the table holds the curve's own value at 1, so asking the curve gives the same answer
palette/tables.go At: !(along >= 0 && along <= 1) => !(along > 0 && along <= 1) :: at 0 the ramp holds the mixer's own colour at 0, so asking the mixer gives the same answer
palette/tables.go At: !(along >= 0 && along <= 1) => !(along >= 0 && along < 1) :: at 1 the ramp holds the mixer's own colour at 1, so asking the mixer gives the same answer
cmd/colourway/main.go render: wrote++ => wrote-- :: wrote is only compared with zero, and a count that is stepped from zero down is no more zero than one stepped up
cmd/libtheme/main.go parse: if fields[2] == "none" { c.H = 0 } else if c.H, err = finite(fields[2]); err != nil { return swatch.NoLight(), err } => if fields[2] == "none" { } else if c.H, err = finite(fields[2]); err != nil { return swatch.NoLight(), err } :: c.H starts at zero, so a hue of none that is left alone is the hue of zero the branch sets
cmd/libtheme/main.go finite: found, err = strconv.ParseFloat(word, 64) => found, err = strconv.ParseFloat(word, 65) :: strconv.ParseFloat reads every bit size but 32 as 64
cmd/libtheme/main.go ramp: n < 2 => n <= 2 :: at n of 2 the branch sets n to 2, which it already is
cmd/libtheme/main.go ramp: n < 2 => n < 3 :: at n of 2 the branch sets n to 2, which it already is; below 2 it is the same as the original
cmd/libtheme/main.go paintSheet: len(r.Name) > width => len(r.Name) >= width :: at equal length the branch sets width to the length it already is
css/read.go package: everyMatch = -1 => everyMatch = -2 :: FindAllStringSubmatchIndex takes every match for any negative count
internal/mocks/host.go CreateTemp: ret0, _ := ret[0].(host.File) => ret0, _ := ret[1].(host.File) :: excluded: generated by mockgen. This is not an equivalent change. The code is written by game run mocks (go.uber.org/mock) and never edited by hand, and game mutants has no way to leave a folder out
internal/mocks/host.go Lstat: ret0, _ := ret[0].(fs.FileInfo) => ret0, _ := ret[1].(fs.FileInfo) :: excluded: generated by mockgen. This is not an equivalent change. The code is written by game run mocks (go.uber.org/mock) and never edited by hand, and game mutants has no way to leave a folder out
internal/mocks/host.go ReadDir: ret0, _ := ret[0].([]fs.DirEntry) => ret0, _ := ret[1].([]fs.DirEntry) :: excluded: generated by mockgen. This is not an equivalent change. The code is written by game run mocks (go.uber.org/mock) and never edited by hand, and game mutants has no way to leave a folder out
internal/mocks/host.go Stat: ret0, _ := ret[0].(fs.FileInfo) => ret0, _ := ret[1].(fs.FileInfo) :: excluded: generated by mockgen. This is not an equivalent change. The code is written by game run mocks (go.uber.org/mock) and never edited by hand, and game mutants has no way to leave a folder out
internal/plain/plain.go package: drop = -1 => drop = -2 :: strings.Map drops a character for any negative return
internal/table/table.go package: floatBits = 64 => floatBits = 65 :: strconv.ParseFloat reads every bit size but 32 as 64
internal/table/table.go package: anySign = 0 => anySign = 1 :: math.IsInf with 1 leaves out only negative infinity, which light's value < dark refuses with the same error
primitives/bands/share.go Shares: share := Share{first: first, part: make([]float64, last-first+1)} => share := Share{first: first, part: make([]float64, last+first+1)} :: the longer run's extra parts are zero, and outside a run made by Shares the part is zero too
primitives/bands/share.go Shares: share := Share{first: first, part: make([]float64, last-first+1)} => share := Share{first: first, part: make([]float64, last-first+2)} :: the extra part is zero, and outside a run made by Shares the part is zero too
primitives/bands/share.go partIn: return float64(order[index]) > centre => return float64(order[index]) >= centre :: a band's centre is two to a fractional power of a whole number, never a whole nanometre, so no sample sits on it
cmd/visualdocs/page_bands.go bandsPage: nm <= 700 => nm <= 701 :: the loop steps in more than one nanometre or kelvin at a time, so the extra one never starts another pass
cmd/visualdocs/page_bands.go bandsPage: k <= 12000 => k <= 12001 :: the loop steps in more than one nanometre or kelvin at a time, so the extra one never starts another pass
cmd/visualdocs/page_bands.go lamp: spectrum[nm] = 1 => spectrum[nm] = 2 :: lamp scales the light to the asked luminance by dividing by its own, so twice the power gives the same light
cmd/visualdocs/page_bands.go bandsCSS: first, last := bands.Of(380), bands.Of(700) => first, last := bands.Of(381), bands.Of(700) :: 381 nm falls in the same band as 380 nm, so the first band is the same
cmd/visualdocs/page_bands.go bandsCSS: first, last := bands.Of(380), bands.Of(700) => first, last := bands.Of(380), bands.Of(701) :: 701 nm falls in the same band as 700 nm, so the last band is the same
cmd/visualdocs/page_observer.go lifted: c.G > m => c.G >= m :: at a tie the maximum is the same number
cmd/visualdocs/page_observer.go lifted: c.B > m => c.B >= m :: at a tie the maximum is the same number
cmd/visualdocs/page_observer.go observerPage: nm <= 700 => nm <= 701 :: the loop steps in more than one nanometre or kelvin at a time, so the extra one never starts another pass
cmd/visualdocs/page_observer.go observerCSS: nm <= 700 => nm <= 701 :: the loop steps in more than one nanometre or kelvin at a time, so the extra one never starts another pass
cmd/visualdocs/page_ok.go okCSS: return ":root {\n" + " --l: " + grey.String(hexOf) + ";\n" + " --h: linear-gradient(in oklch longer hue,\n" + strings.Join(wheel, ",\n") + ");\n" + " --c: linear-gradient(in oklch,\n" + " " + ok.OKLCH{L: 0.7, C: 0, H: 345}.String() + " 0%,\n" + " " + ok.OKLCH{L: 0.7, C: 0.2, H: 345}.String() + " 100%);\n" + "}\n" => return ":root {\n" + " --l: " + grey.String(hexOf) + ";\n" + " --h: linear-gradient(in oklch longer hue,\n" + strings.Join(wheel, ",\n") + ");\n" + " --c: linear-gradient(in oklch,\n" + " " + ok.OKLCH{L: 0.7, C: 0, H: 346}.String() + " 0%,\n" + " " + ok.OKLCH{L: 0.7, C: 0.2, H: 345}.String() + " 100%);\n" + "}\n" :: a grey has no hue: oklch prints its hue as none, so the sheet reads the same
dialects/ghostty/ghostty.go Read: text == "" || strings.HasPrefix(text, "#") || !found => text == "" && strings.HasPrefix(text, "#") || !found :: a blank line has no equals sign so !found skips it, and a comment that has one is cut at a key that begins with "#", which names no setting, so it is passed over either way
dialects/grafana/grafana.go Shade: d < 0 => d <= 0 :: a shade with d of 0 returns the colour on the line above, so d is never 0 here
dialects/nvim/nvim.go takeTerminal: hexes.FindAllStringSubmatch(text, -1) => hexes.FindAllStringSubmatch(text, -2) :: any negative count finds every match
dialects/nvim/nvim.go Contrast: lighter < darker => lighter <= darker :: when they are equal the swap changes nothing
dialects/nvim/nvim.go luminance: return y / white => return y * white :: white's y is exactly 1, so dividing and multiplying by it give the same number
readable/pairs.go hueApart: apart > halfCircle => apart >= halfCircle :: at exactly 180 degrees the fold gives 360 minus 180, which is 180
primitives/bands/bands.go Swatch: if p == 0 { continue } => if p == 0 { } :: a band of no power adds nothing times a finite weight, which is zero added to the sum
primitives/bands/bands.go weight: float64(nm) < hi+1 => float64(nm) <= hi+1 :: an nm at hi+1 is past the band's top, so it fails the band test on the next line
primitives/bands/bands.go weight: float64(nm) < hi+1 => float64(nm) < hi+2 :: the extra nanometres are past the band's top and the band test on the next line skips them
primitives/bands/bands.go unit: order := make([]int, 0, len(d)) => order := make([]int, 1, len(d)) :: the extra entry is 0 nm, which D65 has no power at and the observer no row for, so it adds nothing to the sum
primitives/swatch/observer.go Observed: first || nm < lo => first || nm <= lo :: at nm equal to lo, lo is set to the value it already has
primitives/swatch/observer.go Observed: first || nm > hi => first || nm >= hi :: at nm equal to hi, hi is set to the value it already has
primitives/swatch/observer.go Illuminant: ok && len(w) == 3 => ok || len(w) == 3 :: table.Must refuses a row that does not have three values, so a row is there exactly when it has three
primitives/swatch/observer.go Monochrome: !ok || len(w) != 3 => !ok && len(w) != 3 :: table.Must refuses a row that does not have three values, so a row is there exactly when it has three
primitives/swatch/planck.go Planckian: if kelvin <= 0 { return noLight } => if kelvin <= 0 { } :: Blackbody is empty at zero and below, and Illuminant of nothing is no light
primitives/swatch/planck.go Planckian: kelvin <= 0 => kelvin < 0 :: at zero Blackbody is empty, and Illuminant of nothing is no light, the same answer
primitives/swatch/planck.go Planckian: kelvin <= 0 => kelvin <= 1 :: up to one kelvin every Blackbody entry is zero, and Illuminant of all zeros is no light, the same answer
primitives/swatch/swatch.go Fit: best, dist := p, math.Inf(1) => best, dist := p, math.Inf(2) :: Inf with any sign above zero is positive infinity
primitives/swatch/swatch.go nearest: if l2 == 0 { return a } => if l2 == 0 { } :: a zero-length edge then gives NaN, which Fit's distance test skips, and its corner is the end of the next edge, which Fit reaches; only a triangle of one point has no other edge, and Contains is true everywhere on it
spaces/radiation/radiation.go Of: math.Hypot(d.X, d.Y) < 1e-9 || !p.spectral(d) => math.Hypot(d.X, d.Y) <= 1e-9 || !p.spectral(d) :: the distance is a hypot of two differences of chromaticities near the white, and those are whole multiples of 2^-54; searched every step pair up to 1e-9 (1.8e7 steps one way, the other within 3 of the circle) and none has a Hypot of exactly 1e-9 on arm64, so no input tells < from <=
spaces/radiation/radiation.go Of: best, closest := 0, math.Inf(1) => best, closest := 1, math.Inf(1) :: spectral being true means the loop has at least one row, which replaces best at once
spaces/radiation/radiation.go Of: best, closest := 0, math.Inf(1) => best, closest := 0, math.Inf(2) :: Inf with any sign above zero is positive infinity
spaces/radiation/radiation.go Of: return p.back(float64(best)), best != 0 => return p.back(float64(best)), best != 1 :: best is a row of the observer, so never 0 or 1 after spectral is true
spaces/radiation/radiation.go Light: power != 0 && z > a => power != 0 && z >= a :: at z equal to a the power is multiplied by zero, and a zero entry adds nothing to a swatch
spaces/radiation/radiation.go holds: return r.Lo > 0 && r.Hi > r.Lo => return r.Lo >= 0 && r.Hi > r.Lo :: a source range from zero puts each position at NaN, or at zero for Source.Lo itself (1196 positions probed in review), and neither names a row of the observer or shows light, as the range being refused shows none
spaces/radiation/radiation.go spectral: lo, hi := math.Inf(1), math.Inf(-1) => lo, hi := math.Inf(2), math.Inf(-1) :: Inf with any sign above zero is positive infinity
spaces/radiation/radiation.go spectral: lo, hi := math.Inf(1), math.Inf(-1) => lo, hi := math.Inf(1), math.Inf(-2) :: Inf with any sign below zero is negative infinity
spaces/radiation/radiation.go spectral: !math.IsInf(lo, 1) => !math.IsInf(lo, 2) :: IsInf with any sign above zero asks for positive infinity
spaces/radiation/radiation.go spectral: a += math.Round((prev-a)/(2*math.Pi)) * 2 * math.Pi => a += math.Round((prev-a)/(3*math.Pi)) * 2 * math.Pi :: between neighbouring rows the angle moves under 5 degrees or wraps by nearly a whole turn, and both divisors round those two alike
spaces/radiation/radiation.go spectral: k <= 1 => k < 1 :: the sweep never rises above 177.8 degrees for any run of rows, so a direction plus a whole turn is never in it
spaces/radiation/radiation.go spectral: k <= 1 => k <= 2 :: the sweep never rises above 177.8 degrees for any run of rows, so a direction plus two turns is never in it
spaces/radiation/radiation.go spectral: at := phi + k*2*math.Pi => at := phi - k*2*math.Pi :: k runs from -1 to 1, so the same three turns are tried in the other order
spaces/srgb/srgb.go Bytes: if math.IsNaN(v) { return dark } => if math.IsNaN(v) { } :: only on the platforms where converting NaN to a byte gives zero, which is the dark the guard returns: arm64 (measured, so no test here can fail on it) and amd64 (read, not run). The Go spec leaves that conversion undefined, so the guard stays for the others
spaces/srgb/srgb.go hueAndRange: h = math.Mod((c.G-c.B)/d, 6) => h = math.Mod((c.G-c.B)/d, 7) :: with red the brightest lamp, (G-B)/d is between -1 and 1, which neither modulus changes
spaces/srgb/srgb.go fromHue: h < 1 => h <= 1 :: at h of 1 the case below and the case above give the same lamps, since x equals chroma or zero there
spaces/srgb/srgb.go fromHue: h < 2 => h <= 2 :: at h of 2 the case below and the case above give the same lamps, since x equals chroma or zero there
spaces/srgb/srgb.go fromHue: h < 3 => h <= 3 :: at h of 3 the case below and the case above give the same lamps, since x equals chroma or zero there
spaces/srgb/srgb.go fromHue: h < 4 => h <= 4 :: at h of 4 the case below and the case above give the same lamps, since x equals chroma or zero there
spaces/srgb/srgb.go fromHue: h < 5 => h <= 5 :: at h of 5 the case below and the case above give the same lamps, since x equals chroma or zero there
