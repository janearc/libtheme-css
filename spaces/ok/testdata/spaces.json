    "grey": {"L": 0.5, "C": 0, "H": 0},
    "a hair": {"L": 0.5, "A": 1e-12, "B": -1e-12},
    "exactly exact": {"L": 0.5, "A": 1e-9, "B": 0},
    "wheel": [
      {"lab": {"L": 0.5, "A": 0, "B": -0.1}, "hue": 270},
      {"lab": {"L": 0.5, "A": 0.1, "B": -0.1}, "hue": 315},
      {"lab": {"L": 0.5, "A": 0.1, "B": 0.1}, "hue": 45},
      {"lab": {"L": 0.5, "A": -0.1, "B": 0.1}, "hue": 135},
      {"lab": {"L": 0.5, "A": -0.1, "B": -0.1}, "hue": 225}
    ],
    "tolerance degrees": 1e-9
  },
  "white": {
    "about": "the reference values of the space are given to three places, so white agrees to 1e-3.",
